# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# Google Gemini API key, used ONLY by the offline translation tool
# (backend/tools/translate_stories.py). It is never read by the running
# FastAPI service, so the request path works with this unset.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model used for first-pass translation drafts, and for the two
# opt-in AI surfaces in the running service (Route Guide + Companion Chat).
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated languages to draft translations for, using the same
# language_code values as content_store.py.
TRANSLATION_TARGET_LANGUAGES=zu,af,xh

# ---------------------------------------------------------------------------
# Spatial layer (optional)
# ---------------------------------------------------------------------------
# Set DATABASE_URL to a PostgreSQL instance with PostGIS available to run the
# corridor geometry, journey telemetry and ETA on real spatial queries
# (ST_ClosestPoint / ST_LineLocatePoint against a geography LineString).
#
#   DATABASE_URL=postgresql://user:pass@host:5432/kasi_compass
#
# Requires: pip install 'psycopg[binary]'
#
# Unset — which is the default, and what the demo runs on — the identical API
# contract is served by an in-process SQLite store, so nothing needs to be
# provisioned to run the project. Check /health to see which driver is live.
# DATABASE_URL=

# Where the SQLite fallback persists to. Unset or empty means in-memory only,
# so a restart clears journey telemetry. Set a path to keep it across restarts.
# SQLITE_PATH=

