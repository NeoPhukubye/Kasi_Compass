# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# Google Gemini API key, used ONLY by the offline translation tool
# (backend/tools/translate_stories.py). It is never read by the running
# FastAPI service, so the request path works with this unset.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model used for first-pass translation drafts.
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated languages to draft translations for, using the same
# language_code values as content_store.py.
TRANSLATION_TARGET_LANGUAGES=zu,af,xh
